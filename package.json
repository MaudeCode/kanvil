{
  "name": "@maudecode/kanvil",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, self-hosted ticketing for agents and people.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "vp check && pnpm typecheck && pnpm test",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings",
    "test": "vp test run",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:up": "docker compose -f compose.dev.yml up -d --wait",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:migrate": "pnpm --filter @kanvil/server migrate",
    "configure": "node scripts/configure.ts",
    "dev": "pnpm --filter @kanvil/server dev"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite-plus": "1.2.0"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "pnpm@12.11.2"
}
