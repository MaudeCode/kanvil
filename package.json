{
  "name": "@maudecode/kanvil",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, self-hosted ticketing for agents and people.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "vp check && pnpm typecheck && pnpm test",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings",
    "test": "vp test run",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "db:up": "docker compose -f compose.dev.yml up -d --wait",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:migrate": "pnpm --filter @kanvil/server migrate",
    "configure": "node scripts/configure.ts",
    "dev": "pnpm --parallel --filter @kanvil/server --filter @kanvil/web dev",
    "build": "pnpm --filter @kanvil/web build && pnpm --filter @kanvil/server build",
    "test:e2e": "pnpm build && playwright test",
    "test:oidc": "node scripts/test-oidc.ts",
    "assets:generate": "node scripts/generate-assets.ts",
    "mobile:export": "pnpm --filter @kanvil/mobile export",
    "native:auth-fixture": "node scripts/native-auth-fixture.ts",
    "example:mirror": "node --env-file-if-exists=.env examples/mirror-project.ts",
    "example:mcp": "node --env-file-if-exists=.env examples/mcp-client.ts",
    "account:recover": "pnpm --filter @kanvil/server recover",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env scripts/restore.ts",
    "test:docker": "docker build -t kanvil:local . && node scripts/docker-smoke.ts",
    "test:services": "node scripts/test-services.ts",
    "package": "pnpm build && node scripts/package.ts",
    "test:package": "pnpm package && node scripts/package-smoke.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "pnpm@12.11.2"
}
