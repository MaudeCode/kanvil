DATABASE_URL=postgres://kanvil:kanvil@127.0.0.1:55462/kanvil
KANVIL_URL=http://localhost:5180
KANVIL_DATABASE=kanvil
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
KANVIL_SETUP_TOKEN=
HOST=127.0.0.1
PORT=5180
# Additional browser development origins, comma-separated.
KANVIL_TRUSTED_ORIGINS=http://localhost:5173
# Write requests per minute allowed for one signed-in account before 429 responses.
KANVIL_SESSION_WRITE_LIMIT=120
# Configure all three OIDC values together. Omit them to use local login only.
# OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=PocketID
# Built-in OAuth apps; set both values to offer one. They only sign in accounts that linked them.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Optional native push delivery through Expo. Disabled by default.
KANVIL_PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=
# SMTP relay for email notification channels, sign-in codes, and password reset. Omit to hide them.
# SMTP_URL=smtp://user:password@mail.example.com:587
# SMTP_FROM=Kanvil <kanvil@example.com>
# Let notification channels, project destinations, and Jira import sites reach loopback and
# private networks.
KANVIL_DELIVERY_ALLOW_PRIVATE=false
# The GitHub API that repository connections call. Set it for GitHub Enterprise Server.
# KANVIL_GITHUB_API_URL=https://api.github.com
# The Linear GraphQL API that imports read.
# KANVIL_LINEAR_API_URL=https://api.linear.app/graphql

# Optional integrations. Omit the provider variables to configure them in Administration.
# Explicit providers override the saved admin selection, including local/postgres.
# KANVIL_STORAGE_PROVIDER=local
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=kanvil
# S3_PREFIX=kanvil/
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# KANVIL_SEARCH_PROVIDER=postgres
# ELASTICSEARCH_URL=http://elasticsearch:9200
# ELASTICSEARCH_INDEX=kanvil-instance
# ELASTICSEARCH_AUTH=apiKey
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# KANVIL_BROKER_PROVIDER=postgres
# RABBITMQ_URL=amqps://kanvil:password@rabbitmq:5671/kanvil
# RABBITMQ_EXCHANGE=kanvil.events
