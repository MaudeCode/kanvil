DATABASE_URL=postgres://kanvil:kanvil@127.0.0.1:55462/kanvil
KANVIL_URL=http://localhost:5180
KANVIL_DATABASE=kanvil
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
KANVIL_SETUP_TOKEN=
HOST=127.0.0.1
PORT=5180
# Additional browser development origins, comma-separated.
KANVIL_TRUSTED_ORIGINS=http://localhost:5173
# Configure all three OIDC values together. Omit them to use local login only.
# OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=PocketID
# Optional native push delivery through Expo. Disabled by default.
KANVIL_PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=

# Optional integrations. Omit the provider variables to configure them in Administration.
# Explicit providers override the saved admin selection, including local/postgres.
# KANVIL_STORAGE_PROVIDER=local
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=kanvil
# S3_PREFIX=kanvil/
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# KANVIL_SEARCH_PROVIDER=postgres
# ELASTICSEARCH_URL=http://elasticsearch:9200
# ELASTICSEARCH_INDEX=kanvil-instance
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# KANVIL_BROKER_PROVIDER=postgres
# RABBITMQ_URL=amqps://kanvil:password@rabbitmq:5671/kanvil
# RABBITMQ_EXCHANGE=kanvil.events
