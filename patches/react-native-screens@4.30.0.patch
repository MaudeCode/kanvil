+  CGRect bounds = _observedLayer.bounds;
+  if (CGRectIsEmpty(bounds)) {
+    // A native viewport entering the recycle pool must not retain its former header clearance.
+    _coveredHeight = 0;
+    _foregroundBottom = 0;
