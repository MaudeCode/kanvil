+static void *RNSLegibilityBoundsContext = &RNSLegibilityBoundsContext;
+static char RNSLegibilityMaskKey;
+@interface RNSScrollLegibilityMask : NSObject
+- (instancetype)initWithLayer:(CALayer *)layer;
+- (void)updateCoveredHeight:(CGFloat)height foregroundBottom:(CGFloat)foreground;
+- (void)updateMask;
+@end
+@implementation RNSScrollLegibilityMask {
+  CALayer *_observedLayer;
+  CAGradientLayer *_gradient;
+  CGFloat _coveredHeight;
+  CGFloat _foregroundBottom;
+}
+- (instancetype)initWithLayer:(CALayer *)layer
+{
+  if (self = [super init]) {
+    _observedLayer = layer;
+    _gradient = [CAGradientLayer layer];
+    _gradient.colors = @[(__bridge id)UIColor.clearColor.CGColor, (__bridge id)UIColor.clearColor.CGColor,
+                         (__bridge id)[UIColor colorWithWhite:0 alpha:0.06].CGColor,
+                         (__bridge id)UIColor.blackColor.CGColor, (__bridge id)UIColor.blackColor.CGColor];
+    [_observedLayer addObserver:self forKeyPath:@"bounds" options:0 context:RNSLegibilityBoundsContext];
+  }
+  return self;
+}
+- (void)updateCoveredHeight:(CGFloat)height foregroundBottom:(CGFloat)foreground
+{
+  _coveredHeight = height;
+  _foregroundBottom = foreground;
+  [self updateMask];
