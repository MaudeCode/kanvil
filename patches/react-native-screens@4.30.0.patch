+  // Respect masks owned by another component.
+  if (_observedLayer.mask != nil && _observedLayer.mask != _gradient) return;
+  CGFloat end = MIN(_coveredHeight, bounds.size.height);
+  CGFloat start = MAX(0, MIN(_foregroundBottom, end));
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  _gradient.frame = bounds;
+  _gradient.locations = @[@0, @(start / bounds.size.height),
+                           @((start + (end - start) * 0.8) / bounds.size.height),
+                           @(end / bounds.size.height), @1];
+  _observedLayer.mask = _gradient;
