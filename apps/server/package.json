{
  "name": "@kanvil/server",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env src/cli/migrate.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "auth generate --config auth.config.ts --output src/auth-schema.ts --yes",
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.mjs",
    "build": "vp pack",
    "recover": "node --env-file-if-exists=../../.env src/cli/recover.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@better-auth/api-key": "1.7.14",
    "@better-auth/cimd": "1.7.14",
    "@better-auth/drizzle-adapter": "1.7.14",
    "@better-auth/expo": "1.7.14",
    "@better-auth/mcp": "1.7.14",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@iconify-json/lucide": "1.2.148",
    "@inquirer/password": "5.2.5",
    "@kanvil/contracts": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "amqplib": "2.2.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "expo-server-sdk": "7.2.0",
    "hono": "4.13.14",
    "i18next": "26.5.11",
    "jose": "6.2.13",
    "mdast-util-from-markdown": "2.1.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "turndown": "7.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kanvil/client": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/s3rver": "3.7.4",
    "@types/turndown": "5.0.6",
    "auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "s3rver": "3.7.1"
  }
}
