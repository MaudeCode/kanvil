{
  "name": "@kanvil/server",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env src/cli/migrate.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "auth generate --config auth.config.ts --output src/auth-schema.ts --yes",
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.mjs",
    "build": "vp pack",
    "recover": "node --env-file-if-exists=../../.env src/cli/recover.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.8",
    "@better-auth/cimd": "1.7.8",
    "@better-auth/drizzle-adapter": "1.7.8",
    "@better-auth/expo": "1.7.8",
    "@better-auth/mcp": "1.7.8",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@inquirer/password": "5.2.3",
    "@kanvil/contracts": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.8",
    "drizzle-orm": "0.45.4",
    "expo-server-sdk": "7.2.0",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kanvil/client": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/pg": "8.23.1",
    "auth": "1.7.8",
    "drizzle-kit": "0.31.11"
  }
}
